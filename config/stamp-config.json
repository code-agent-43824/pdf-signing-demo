{
  "appearance": {
    "width": 150,
    "height": 70,
    "imageScale": 4,
    "backgroundColor": "#F5F8FF",
    "borderColor": "#3F68B8",
    "borderWidth": 2,
    "borderRadius": 26,
    "textColor": "#0D4DC5",
    "separator": {
      "enabled": false,
      "y": 56,
      "left": 28,
      "right": 28,
      "color": "#6E87BC",
      "width": 1
    },
    "fonts": {
      "title": {
        "path": "public/assets/fonts/stamp/Roboto Condensed Medium.ttf",
        "size": 30
      },
      "label": {
        "path": "public/assets/fonts/stamp/Roboto Condensed Medium.ttf",
        "size": 22
      },
      "value": {
        "path": "public/assets/fonts/stamp/Roboto Condensed Medium.ttf",
        "size": 22
      }
    },
    "layout": {
      "contentLeft": 24,
      "contentRight": 24,
      "startY": 12,
      "titleLineHeight": 30,
      "afterTitleGap": 40,
      "rowLabelGap": 24,
      "rowExtraGap": 20,
      "valueLineHeight": 24,
      "defaultMaxLines": 2
    }
  },
  "content": {
    "title": [
      "Документ подписан электронной подписью"
    ],
    "rows": [
      {
        "label": "ID сертификата",
        "value": "{signer.cert_id}",
        "maxLines": 2,
        "breakAnywhere": true
      },
      {
        "label": "ФИО владельца",
        "value": "{signer.name}",
        "maxLines": 2,
        "breakAnywhere": false
      },
      {
        "label": "Кем выдан",
        "value": "{signer.issuer}",
        "maxLines": 2,
        "breakAnywhere": false
      },
      {
        "label": "Срок действия",
        "value": "{signer.valid_to}",
        "maxLines": 2,
        "breakAnywhere": false
      }
    ]
  },
  "signatureObject": {
    "name": "{signer.name}",
    "reason": "Выдан: {signer.issuer}",
    "contactInfo": "Cert ID: {signer.cert_id}",
    "location": "Web UI",
    "bytesReserved": 16000,
    "subfilter": "PADES"
  },
  "placements": {
    "rules": [
      {
        "name": "default-grid",
        "pages": {
          "mode": "all",
          "page": 1,
          "widgetPageMode": "last"
        },
        "placement": {
          "mode": "grid",
          "anchor": "bottom-right",
          "offsetX": 24,
          "offsetY": 24,
          "columns": 4,
          "stepX": -139,
          "stepY": 116
        }
      }
    ]
  },
  "limits": {
    "maxSignatures": 4
  }
}
