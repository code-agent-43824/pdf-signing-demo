{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // Vendor scripts are pinned byte for byte (docs/VENDOR_ASSETS.md).
    "includes": ["**/*.js", "!public/vendor"]
  },
  "assist": {
    "enabled": false
  },
  // Closest to the hand-written style the code had before the formatter:
  // operators at the start of wrapped lines, single quotes.
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "operatorLinebreak": "before"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      // Ajv schemas use the JSON Schema keywords `if` and `then`.
      "includes": ["src/http/validation.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noThenProperty": "off"
          }
        }
      }
    }
  ]
}
