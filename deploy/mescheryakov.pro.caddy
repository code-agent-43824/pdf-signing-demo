mescheryakov.pro, www.mescheryakov.pro {
    handle /pdf-signing/* {
        # CSP and browser response headers are emitted by the application.
        header Strict-Transport-Security "max-age=31536000; includeSubDomains"
        reverse_proxy 127.0.0.1:3010
    }

    handle /pdf-signing {
        redir /pdf-signing/ 308
    }

    handle {
        root * /home/openclaw/sites/mescheryakov.pro/public
        encode zstd gzip
        file_server
    }
}
